# Root environment for docker compose (VPS only — NEVER commit real values).
# Copy to `.env` on the VPS and fill in (chmod 600):
#   cp .env.example .env && chmod 600 .env

# Postgres superuser password (compose fails fast if unset).
# Generate: openssl rand -hex 16
POSTGRES_PASSWORD=change-me-generate-with-openssl-rand-hex-16

# Cloudflare Tunnel token for the bestway tunnel
# (Zero Trust -> Networks -> Tunnels -> bestway -> Install connector -> token).
# The cloudflared service fails fast if unset. chmod 600 with .env.
TUNNEL_TOKEN=change-me-paste-cloudflare-tunnel-token-here
