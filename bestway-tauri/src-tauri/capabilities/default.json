{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege: core window controls for kiosk + opener/deep-link for browser login + clipboard wipe on lock (single-instance plugin has no permissions)",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-always-on-top",
    "core:window:allow-set-focus",
    "opener:allow-open-url",
    "deep-link:allow-get-current",
    "deep-link:allow-on-open-url",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-clear"
  ]
}
