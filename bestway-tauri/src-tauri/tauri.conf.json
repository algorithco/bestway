{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bestway App",
  "version": "0.1.1",
  "identifier": "uz.bestway.exam",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bestway Exam",
        "width": 1280,
        "height": 800,
        "fullscreen": false,
        "decorations": true,
        "alwaysOnTop": false,
        "resizable": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 http://localhost:3000 http://localhost:3001 https://localhost:3000 https://localhost:3001",
      "devtools": false
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg", "appimage", "deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education"
  },
  "plugins": {
    "updater": {
      "active": false
    },
    "deepLink": {
      "desktop": {
        "schemes": ["bestway-exam"]
      }
    }
  }
}
