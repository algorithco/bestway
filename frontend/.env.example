# Frontend environment (server-only — no NEXT_PUBLIC_ secrets)
# Local dev:
API_URL=http://localhost:3001/v1
# Docker Compose prod (internal DNS, set via compose args/env — no rebuild needed for runtime routes):
# API_URL=http://backend:3001/v1
# Optional extra next/image host (build-time, requires rebuild if changed):
# NEXT_PUBLIC_MEDIA_HOST=
