# --- Baza ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/education_center?schema=public"

# --- Server ---
PORT=3001
# Frontend manzili (CORS uchun, vergul bilan bir nechta bo'lishi mumkin)
# Tauri desktop originlari backendda avtomatik ruxsat etiladi
# (tauri://localhost, http://tauri.localhost, http://localhost:1420),
# lekin prod web domen(lar)ni shu yerga yozing:
CORS_ORIGIN=http://localhost:3000
# Desktop deep-link qaytish manzillari (vergul bilan ro'yxat).
# Tauri + web + backend uchalasi ham bir xil qiymatni ishlatishi shart.
DESKTOP_REDIRECT_URIS=bestway-exam://auth/callback
# Desktop ilova yangilanish xabarnomasi (GET /v1/desktop-version).
# DESKTOP_LATEST_VERSION hozirgi relizdan katta bo'lsa, student ilovada toast ko'radi.
# downloadUrl bo'sh bo'lsa — faqat xabar chiqadi, "Update now" tugmasi yashiriladi.
DESKTOP_LATEST_VERSION=0.2.0
DESKTOP_DOWNLOAD_URL=
# Tashqaridan ko'rinadigan backend manzili (video stream URL yasashda ishlatiladi)
PUBLIC_URL=http://localhost:3001

# --- JWT ---
JWT_SECRET=change-me-jwt
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Video streaming ---
STREAM_TOKEN_SECRET=change-me-stream
STREAM_URL_TTL_SECONDS=3600
STORAGE_DIR=./storage
MAX_UPLOAD_MB=500

# --- Telegram bot (ixtiyoriy; bo'sh bo'lsa faqat in-app bildirishnoma ishlaydi) ---
# @BotFather dan olinadi
TELEGRAM_BOT_TOKEN=
# Deep link uchun (masalan "bilim_markaz_bot"). Bo'sh bo'lsa getMe orqali aniqlanadi.
TELEGRAM_BOT_USERNAME=
# Bog'lash havolasining amal qilish muddati (daqiqa)
TELEGRAM_LINK_TTL_MINUTES=10
# polling | webhook | off
#   polling — dev va oddiy serverlar (domen/HTTPS shart emas)
#   webhook — prodakshan (HTTPS majburiy)
TELEGRAM_MODE=polling
# Faqat webhook rejimi uchun:
TELEGRAM_WEBHOOK_URL=
# Tasodifiy uzun satr — Telegram har so'rovda shu qiymatni header'da qaytaradi
TELEGRAM_WEBHOOK_SECRET=

# --- Markaz nomi (PDF sertifikatda chiqadi) ---
CENTER_NAME=Bilim O'quv Markazi

# --- Seed (birinchi ishga tushirishda yaratiladigan super admin) ---
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_PHONE=+998900000001
SEED_SUPER_ADMIN_PASSWORD=Super123!
